# TalentFit uses local Ollama models and does not require a cloud API key.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
EMBEDDING_MODEL=qwen3-embedding:0.6b

# Local vector database
CHROMA_PATH=data/chroma
COLLECTION_NAME=talentfit_jobs

# Search and result sizes
TOP_K_RETRIEVAL=100
TOP_K_RESULTS=5
